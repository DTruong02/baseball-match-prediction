DATABASE_URL=postgresql://baseball:baseball@localhost:5432/baseball
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_HOST=0.0.0.0
API_PORT=8000
ARTIFACTS_ROOT=artifacts
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
# Comma-separated browser origins for CORS (local Next.js + production site).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LIVE_CACHE_TTL_COMPLETED_SECONDS=3600
LIVE_PUBSUB_ENABLED=true
LIVE_POLL_INTERVAL_SECONDS=15
LIVE_POLL_GAME_DELAY_SECONDS=0.5
LIVE_POLL_MIN_REQUEST_INTERVAL_SECONDS=0.5
LIVE_SYNC_RETRIES=2
LIVE_SYNC_BACKOFF_SECONDS=0.5
LIVE_STALE_AFTER_SECONDS=90
# Process-wide spacing for all MLB Stats API calls (schedule sync, live, training).
# Lower values speed training; raise if you hit HTTP 429s.
MLB_MIN_REQUEST_INTERVAL_SECONDS=0.08
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFICATION_POLL_INTERVAL_SECONDS=30
NOTIFICATION_EMAIL_RETRIES=2
NOTIFICATION_EMAIL_BACKOFF_SECONDS=0.5
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Also accepted via chat_repl fallbacks: OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL
# Observability (Stage 7.4)
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
# Browser-facing API URL baked into the Next.js image (docker compose build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Oracle Always Free / production (see infra/HOSTING.md) ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMAIN=baseball.example.com
# NEXT_PUBLIC_API_URL=https://baseball.example.com/api
# CORS_ORIGINS=https://baseball.example.com
# POSTGRES_PASSWORD=replace-with-url-safe-secret
# SECRET_KEY=replace-with-long-random-string
