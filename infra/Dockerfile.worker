# Live / notification workers (same runtime as API, different command)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    ARTIFACTS_ROOT=/app/artifacts

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY backend ./backend
COPY configs ./configs

RUN pip install --upgrade pip \
    && pip install ".[backend,chat]"

RUN mkdir -p /app/artifacts /app/cache

# Default: live feed poller. Compose overrides for notification-worker.
CMD ["baseball-live-worker"]
